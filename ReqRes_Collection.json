              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Name matches CSV data\", function () {\r\n    pm.expect(response.name).to.eql(\r\n        pm.iterationData.get(\"name\")\r\n    );\r\n});\r\n\r\npm.test(\"Job matches CSV data\", function () {\r\n    pm.expect(response.job).to.eql(\r\n        pm.iterationData.get(\"job\")\r\n    );\r\n});\r\n\r\npm.test(\"Response contains id\", function () {\r\n    pm.expect(response.id).to.exist;\r\n});\r\n\r\nif (response.id !== undefined) {\r\n    pm.environment.set(\"userId\", String(response.id));\r\n}"
                ]
              }
            }
